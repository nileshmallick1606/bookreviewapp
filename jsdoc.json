{
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "source": {
    "include": [
      "frontend/src",
      "backend/src"
    ],
    "includePattern": ".+\\.(js|jsx|ts|tsx)$",
    "excludePattern": "(node_modules/|docs)"
  },
  "plugins": [
    "plugins/markdown",
    "better-docs/component",
    "better-docs/typescript"
  ],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false,
    "search": true,
    "better-docs": {
      "name": "BookReview Platform Documentation",
      "title": "BookReview Platform Documentation",
      "hideGenerator": true,
      "navLinks": [
        {
          "label": "GitHub",
          "href": "https://github.com/nileshmallick1606/bookreviewapp"
        },
        {
          "label": "API Documentation",
          "href": "/api"
        }
      ]
    }
  },
  "opts": {
    "destination": "./docs/generated/code",
    "encoding": "utf8",
    "private": true,
    "recurse": true,
    "template": "node_modules/better-docs",
    "readme": "./README.md"
  }
}
